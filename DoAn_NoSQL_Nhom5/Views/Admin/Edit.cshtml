@model AdminEditVM
@{ ViewData["Title"] = "Cập nhật tài khoản"; }
<main class="shell page-space" id="main-content"><div class="breadcrumb"><a asp-action="Index">Quản lý người dùng</a><icon name="chevron" /><span>Cập nhật tài khoản</span></div><div class="admin-form"><div class="page-heading"><div><div class="eyebrow">PHÂN QUYỀN VÀ TRẠNG THÁI</div><h1>Cập nhật tài khoản</h1><p>Quản lý quyền truy cập của người dùng.</p></div></div><section class="panel"><div class="broker-card-top"><span class="avatar avatar-lg">@Ui.Initials(Model.HoTen)</span><div><h2>@Model.HoTen</h2><span class="muted">@Model.Email</span></div></div><p class="account-code">@Model.MaUser</p><form asp-action="Edit" method="post"><input asp-for="MaUser" type="hidden" /><div asp-validation-summary="All"></div><div class="form-field"><label asp-for="VaiTro">Vai trò tài khoản</label><select asp-for="VaiTro">@foreach (var r in UserRoles.All) { <option value="@r">@Ui.Role(r)</option> }</select></div><label class="checkbox-row"><input asp-for="IsLocked" />Khóa quyền đăng nhập của tài khoản này</label><p class="muted" style="font-size:12px">Thay đổi quyền hoặc trạng thái sẽ kết thúc các phiên đăng nhập cũ. Bạn không thể tự khóa hoặc tự bỏ quyền quản trị của mình.</p><div class="form-actions"><button class="btn btn-primary" type="submit"><icon name="check" />Lưu thay đổi</button><a class="btn btn-outline" asp-action="Index">Hủy</a></div></form></section></div></main>
