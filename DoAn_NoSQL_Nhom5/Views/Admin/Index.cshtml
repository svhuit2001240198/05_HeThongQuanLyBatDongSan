@model AdminListVM
@{ ViewData["Title"] = "Quản lý người dùng"; }
<main class="shell page-space" id="main-content"><div class="page-heading"><div><div class="eyebrow">KHÔNG GIAN QUẢN TRỊ</div><h1>Quản lý người dùng</h1><p>Tra cứu tài khoản, quản lý vai trò và trạng thái hoạt động.</p></div><a class="btn btn-outline" asp-controller="Account" asp-action="Index"><icon name="user" />Tài khoản của tôi</a></div><div class="metrics admin-metrics">@foreach (var role in UserRoles.All) { <a class="metric" asp-action="Index" asp-route-role="@role"><div class="metric-icon"><icon name="@(role == UserRoles.Admin ? "shield" : role == UserRoles.Broker ? "users" : "user")" /></div><strong>@Ui.Number(Model.RoleCounts.GetValueOrDefault(role))</strong><span>@Ui.Role(role)</span></a> }</div><form asp-action="Index" method="get" class="filter-form"><div class="filter-field filter-search"><label for="search">Tra cứu tài khoản</label><input name="search" id="search" value="@Model.Search" maxlength="100" placeholder="Họ tên, email hoặc mã người dùng..." /></div><div class="filter-field"><label for="role">Vai trò</label><select id="role" name="role"><option value="">Tất cả vai trò</option>@foreach (var r in UserRoles.All) { <option value="@r" selected="@(Model.Role == r)">@Ui.Role(r)</option> }</select></div><button class="btn btn-primary" type="submit"><icon name="search" />Tìm kiếm</button><a class="btn btn-outline" asp-action="Index">Đặt lại</a></form>
@if (Model.Result.Items.Count == 0) { <div class="empty-state"><h3>Không có tài khoản phù hợp</h3><p>Kiểm tra lại từ khóa hoặc bộ lọc vai trò.</p></div> } else { <div class="table-wrap"><table><thead><tr><th scope="col">Người dùng</th><th scope="col">Vai trò</th><th scope="col">Ngày tham gia</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach (var u in Model.Result.Items) { <tr><td><div class="table-person"><span class="avatar">@Ui.Initials(u.HoTen)</span><div><strong>@u.HoTen</strong><small>@u.Email</small><small>@u.MaUser</small></div></div></td><td><span class="badge @(u.VaiTro == UserRoles.Admin ? "badge-gold" : "")">@Ui.Role(u.VaiTro)</span></td><td>@Ui.Date(u.NgayTao)</td><td><span class="badge @(u.TrangThaiTaiKhoan == "bi_khoa" ? "badge-red" : "badge-green")">@(u.TrangThaiTaiKhoan == "bi_khoa" ? "Đã khóa" : "Hoạt động")</span></td><td><a class="btn btn-outline btn-small" asp-action="Edit" asp-route-id="@u.MaUser"><icon name="edit" />Chỉnh sửa</a></td></tr> }</tbody></table></div><partial name="_Pagination" model="new PaginationVM { Page = Model.Result.Page, Pages = Model.Result.Pages, Total = Model.Result.Total }" /> }</main>
