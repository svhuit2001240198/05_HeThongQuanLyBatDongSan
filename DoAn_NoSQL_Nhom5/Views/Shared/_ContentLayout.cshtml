<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · HomeLand</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#main-content" class="skip-link">Đến nội dung chính</a>
    <partial name="_Header" />
    <div class="shell main-alerts"><partial name="_Alerts" /></div>
    @RenderBody()
    <partial name="_Footer" />
    <script src="~/js/account.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
