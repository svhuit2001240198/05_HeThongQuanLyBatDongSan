@model PropertyListVM
@{ ViewData["Title"] = "Bất động sản"; }
<main class="shell page-space" id="main-content"><div class="page-heading"><div><div class="eyebrow">TÌM KIẾM TỔ ẤM</div><h1>Khám phá bất động sản</h1><p>@Ui.Number(Model.Result.Total) tin đăng phù hợp với lựa chọn của bạn.</p></div></div><form asp-action="Properties" method="get" class="filter-form"><div class="filter-field filter-search"><label for="search">Từ khóa</label><input id="search" name="search" value="@Model.Search" maxlength="100" placeholder="Tên dự án, căn hộ..." /></div><div class="filter-field"><label for="type">Loại bất động sản</label><select id="type" name="type"><option value="">Tất cả loại hình</option>@foreach (var type in new[] { "can_ho", "dat_nen", "biet_thu" }) { <option value="@type" selected="@(Model.Type == type)">@Ui.PropertyType(type)</option> }</select></div><div class="filter-field"><label for="city">Khu vực</label><input id="city" name="city" value="@Model.City" maxlength="100" placeholder="TP. Hồ Chí Minh..." /></div><button type="submit" class="btn btn-primary"><icon name="search" />Tìm tin</button><a asp-action="Properties" class="btn btn-outline">Đặt lại</a></form>
@if (Model.Result.Items.Count == 0) { <div class="empty-state"><div class="empty-icon"><icon name="search" /></div><h3>Chưa tìm thấy tin phù hợp</h3><p>Thử thay đổi từ khóa hoặc mở rộng khu vực tìm kiếm.</p></div> } else { <div class="property-grid">@foreach (var p in Model.Result.Items) { <partial name="_PropertyCard" model="p" /> }</div><partial name="_Pagination" model="new PaginationVM { Page = Model.Result.Page, Pages = Model.Result.Pages, Total = Model.Result.Total }" /> }</main>
