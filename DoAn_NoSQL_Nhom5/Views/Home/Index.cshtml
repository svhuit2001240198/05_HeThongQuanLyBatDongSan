@model HomeVM
@{ ViewData["Title"] = "Tìm tổ ấm của bạn"; }
<main id="main-content"><section class="hero-home"><div class="shell hero-home-grid"><div><div class="eyebrow">KHÁM PHÁ · KẾT NỐI · AN CƯ</div><h1>Mỗi ngôi nhà,<br />một khởi đầu <em>mới.</em></h1><p>Tìm bất động sản phù hợp, lưu những lựa chọn yêu thích và kết nối với người đăng tin.</p><form class="home-search" asp-controller="Home" asp-action="Properties" method="get"><input name="search" aria-label="Tìm kiếm bất động sản" placeholder="Bạn đang tìm ngôi nhà như thế nào?" /><button class="btn btn-gold" type="submit"><icon name="search" />Tìm kiếm</button></form></div><img src="~/img/property-villa.svg" alt="Minh họa ngôi nhà hiện đại" /></div></section><section class="shell section-space"><div class="page-heading"><div><div class="eyebrow">NHỮNG LỰA CHỌN ĐÁNG XEM</div><h2>Bất động sản nổi bật</h2><p>Khám phá tin đăng và bắt đầu danh sách yêu thích của bạn.</p></div><a class="btn btn-outline" asp-action="Properties">Xem tất cả <icon name="arrow" /></a></div>@if (Model.Featured.Count > 0) { <div class="property-grid">@foreach (var p in Model.Featured) { <partial name="_PropertyCard" model="p" /> }</div> } else { <div class="empty-state"><h3>Chưa có tin đăng</h3><p>Các bất động sản mới sẽ xuất hiện tại đây.</p></div> }</section></main>
