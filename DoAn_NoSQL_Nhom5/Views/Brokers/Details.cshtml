@model BrokerDetailVM
@{ ViewData["Title"] = Model.Broker.HoTen; var b = Model.Broker; }
<main class="shell page-space" id="main-content"><div class="breadcrumb"><a asp-action="Index">Môi giới</a><icon name="chevron" /><span>Hồ sơ môi giới</span></div><section class="broker-header"><span class="avatar avatar-xl">@Ui.Initials(b.HoTen)</span><div class="broker-header-main"><span class="badge badge-gold">Môi giới bất động sản</span><h1>@b.HoTen</h1><p><icon name="pin" />@string.Join(" · ", b.ThongTinMoiGioi?.KhuVucHoatDong ?? [])</p><div class="button-row"><span class="stars">★ <span class="rating-number">@Ui.Rating(b).ToString("0.0")</span></span><span class="muted">@b.DanhGia.Count đánh giá</span><span class="muted">@(b.ThongTinMoiGioi?.KinhNghiem ?? 0) năm kinh nghiệm</span></div></div><span class="badge @(b.ThongTinMoiGioi?.TrangThai == "dang_hoat_dong" ? "badge-green" : "badge-red")">@(b.ThongTinMoiGioi?.TrangThai == "dang_hoat_dong" ? "Đang hoạt động" : "Tạm ngừng hoạt động")</span></section>
<div class="broker-section-grid"><div><section class="panel"><h2>Giới thiệu</h2><p class="muted" style="margin-top:12px;white-space:pre-line">@(string.IsNullOrWhiteSpace(b.ThongTinMoiGioi?.GioiThieu) ? "Môi giới đang cập nhật phần giới thiệu." : b.ThongTinMoiGioi.GioiThieu)</p></section><div class="panel-heading"><h2>Bất động sản phụ trách</h2><span class="badge">@Model.Properties.Total tin</span></div>@if (Model.Properties.Items.Count > 0) { <div class="property-grid">@foreach (var p in Model.Properties.Items) { <partial name="_PropertyCard" model="p" /> }</div><partial name="_Pagination" model="new PaginationVM { Page = Model.Properties.Page, Pages = Model.Properties.Pages, Total = Model.Properties.Total }" /> } else { <div class="empty-state"><h3>Chưa có tin đang hiển thị</h3></div> }
<section class="panel" style="margin-top:25px"><div class="panel-heading"><h2>Đánh giá từ khách hàng</h2><span class="stars">★ @Ui.Rating(b).ToString("0.0") / 5</span></div>@if (b.DanhGia.Count == 0) { <p class="muted">Chưa có đánh giá. Trải nghiệm của bạn có thể giúp những khách hàng tiếp theo.</p> }@foreach (var r in b.DanhGia.OrderByDescending(x => x.NgayDanhGia).Take(20)) { var name = Model.ReviewerNames.GetValueOrDefault(r.MaUserDanhGia, "Khách hàng"); <article class="review"><div class="review-head"><span class="avatar">@Ui.Initials(name)</span><strong>@name</strong><span class="stars">@(new string('★', Math.Clamp(r.SoSao, 1, 5)))</span><span class="review-date">@Ui.Date(r.NgayDanhGia)</span></div><p>@r.NoiDung</p></article> }@if (b.DanhGia.Count > 20) { <p class="muted">Hiển thị 20 đánh giá gần nhất.</p> }</section></div>
<aside><section class="panel"><div class="eyebrow">THÔNG TIN LIÊN HỆ</div><h2>Kết nối với @b.Ten</h2><div class="data-row"><span><icon name="phone" />Điện thoại</span><strong>@b.SDT</strong></div><div class="data-row"><span><icon name="mail" />Email</span><strong>@b.Email</strong></div></section><section class="panel"><h3>Chia sẻ trải nghiệm của bạn</h3><p class="muted" style="font-size:12px;margin-top:9px">Đánh giá chất lượng tư vấn và hỗ trợ của môi giới.</p>
@if (User.Identity?.IsAuthenticated != true) { <a class="btn btn-primary btn-wide" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập để đánh giá</a> } else if (User.FindFirstValue(ClaimTypes.NameIdentifier) == b.MaUser) { <p class="muted">Đây là hồ sơ của bạn.</p> } else if (Model.HasReviewed) { <div class="badge badge-green"><icon name="check" />Bạn đã gửi đánh giá</div> } else { <form asp-action="Review" method="post"><input type="hidden" name="BrokerCode" value="@b.MaUser" /><div class="star-input" role="group" aria-label="Chọn số sao">@for (var i = 1; i <= 5; i++) { <label><input type="radio" name="SoSao" value="@i" checked="@(i == 5)" />@i ★</label> }</div><div class="form-field"><label for="NoiDung">Nội dung đánh giá</label><textarea id="NoiDung" name="NoiDung" required minlength="5" maxlength="1000" placeholder="Môi giới đã hỗ trợ bạn như thế nào?"></textarea></div><button type="submit" class="btn btn-primary btn-wide">Gửi đánh giá <icon name="arrow" /></button></form> }
</section></aside></div></main>
