@model BrokerListVM
@{ ViewData["Title"] = "Đội ngũ môi giới"; }
<main class="shell page-space" id="main-content"><div class="page-heading"><div><div class="eyebrow">TÌM NGƯỜI ĐỒNG HÀNH</div><h1>Môi giới bất động sản</h1><p>Tìm người hỗ trợ theo khu vực và kinh nghiệm chuyên môn.</p></div></div><form asp-action="Index" method="get" class="filter-form"><div class="filter-field filter-search"><label for="area">Khu vực hoạt động</label><input id="area" name="area" value="@Model.Area" maxlength="100" placeholder="TP. Hồ Chí Minh, Bình Dương..." /></div><div class="filter-field"><label for="minExperience">Kinh nghiệm tối thiểu</label><select id="minExperience" name="minExperience">@foreach (var n in new[] { 0, 3, 5, 10 }) { <option value="@n" selected="@(Model.MinExperience == n)">@(n == 0 ? "Tất cả kinh nghiệm" : n + " năm")</option> }</select></div><button type="submit" class="btn btn-primary"><icon name="search" />Tìm môi giới</button><a asp-action="Index" class="btn btn-outline">Đặt lại</a></form>
@if (Model.Result.Items.Count == 0) { <div class="empty-state"><div class="empty-icon"><icon name="users" /></div><h3>Chưa có môi giới phù hợp</h3><p>Thử mở rộng khu vực hoặc điều chỉnh số năm kinh nghiệm.</p></div> } else { <div class="broker-grid">@foreach (var b in Model.Result.Items) { <article class="broker-card"><div class="broker-card-top"><span class="avatar avatar-lg">@Ui.Initials(b.HoTen)</span><div><h3>@b.HoTen</h3><span class="badge badge-green">Đang hoạt động</span></div></div><p>@string.Join(" · ", b.ThongTinMoiGioi?.KhuVucHoatDong ?? [])</p><div class="broker-meta"><span><icon name="building" />@(b.ThongTinMoiGioi?.KinhNghiem ?? 0) năm</span><span class="stars">★ <span class="rating-number">@Ui.Rating(b).ToString("0.0")</span> <span class="muted">(@b.DanhGia.Count)</span></span></div><a class="btn btn-outline btn-wide" asp-action="Details" asp-route-id="@b.MaUser">Xem hồ sơ <icon name="arrow" /></a></article> }</div><partial name="_Pagination" model="new PaginationVM { Page = Model.Result.Page, Pages = Model.Result.Pages, Total = Model.Result.Total }" /> }</main>
