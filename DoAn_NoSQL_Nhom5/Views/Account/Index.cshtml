@model DashboardVM
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Tài khoản của tôi"; ViewData["FavoriteMode"] = true; }
<div class="page-heading"><div><div class="eyebrow">KHÔNG GIAN CỦA BẠN</div><h1>Chào @Model.Account.Ten 👋</h1><p>Tiếp tục khám phá và quản lý những điều bạn quan tâm.</p></div><a class="btn btn-outline" asp-action="Profile"><icon name="edit" />Chỉnh sửa hồ sơ</a></div>
<div class="metrics"><a class="metric" asp-action="Favorites"><div class="metric-icon"><icon name="heart" /></div><strong>@Model.Account.BDSDaLuu.Count</strong><span>Bất động sản đã lưu</span></a><a class="metric" asp-action="Notifications" asp-route-unread="true"><div class="metric-icon"><icon name="bell" /></div><strong>@Model.UnreadCount</strong><span>Thông báo chưa đọc</span></a>@if (Model.Account.VaiTro == UserRoles.Seller || Model.Account.VaiTro == UserRoles.Broker || Model.Account.VaiTro == UserRoles.Admin) { <a class="metric" asp-action="ManagedProperties"><div class="metric-icon"><icon name="building" /></div><strong>@Model.ManagedCount</strong><span>Quản lý bất động sản</span></a> } else { <div class="metric"><div class="metric-icon"><icon name="building" /></div><strong>@Model.ManagedCount</strong><span>Bất động sản phụ trách</span></div> }</div>
<div class="welcome-banner"><icon name="home" /><div><h2>Mọi lựa chọn, trong một tài khoản.</h2><p>Lưu tin để dễ so sánh. Hoàn thiện hồ sơ để kết nối thuận tiện hơn.</p></div></div>
<section class="panel"><div class="panel-heading"><div><h2>Thông tin tài khoản</h2><p>Thông tin bạn sử dụng khi kết nối với người đăng tin.</p></div><span class="badge badge-green">Đang hoạt động</span></div><div class="data-row"><span>Họ và tên</span><strong>@Model.Account.HoTen</strong></div><div class="data-row"><span>Email</span><strong>@Model.Account.Email</strong></div><div class="data-row"><span>Số điện thoại</span><strong>@Model.Account.SDT</strong></div><div class="data-row"><span>Vai trò</span><strong>@Ui.Role(Model.Account.VaiTro)</strong></div><div class="data-row"><span>Tham gia từ</span><strong>@Ui.Date(Model.Account.NgayTao)</strong></div></section>
<div class="panel-heading"><h2>Tin bạn đã lưu</h2><a class="btn btn-text" asp-action="Favorites">Xem tất cả <icon name="arrow" /></a></div>
@if (Model.Saved.Count > 0) { <div class="property-grid">@foreach (var p in Model.Saved) { <partial name="_PropertyCard" model="p" /> }</div> }
else { <div class="empty-state"><div class="empty-icon"><icon name="heart" /></div><h3>Bắt đầu danh sách yêu thích</h3><p>Lưu những tin bạn quan tâm để quay lại xem và so sánh bất cứ lúc nào.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Properties">Khám phá bất động sản</a></div> }
