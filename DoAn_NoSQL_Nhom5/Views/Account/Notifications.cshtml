@model List<ThongBaoUser>
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Thông báo"; var unread = ViewBag.Unread is true; }
<div class="page-heading"><div><div class="eyebrow">CẬP NHẬT DÀNH CHO BẠN</div><h1>Thông báo</h1><p>Theo dõi những thông tin và tương tác mới với tài khoản.</p></div><form asp-action="ReadAll" method="post"><button type="submit" class="btn btn-outline"><icon name="check" />Đánh dấu tất cả đã đọc</button></form></div>
<nav class="tab-row" aria-label="Bộ lọc thông báo"><a class="@(!unread ? "active" : "")" asp-action="Notifications">Tất cả</a><a class="@(unread ? "active" : "")" asp-action="Notifications" asp-route-unread="true">Chưa đọc</a></nav>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon"><icon name="bell" /></div><h3>@(unread ? "Bạn đã đọc hết thông báo" : "Chưa có thông báo")</h3><p>Những cập nhật mới sẽ xuất hiện tại đây.</p></div> }
else { <div class="notification-list">@foreach (var item in Model) { <article class="notification @(!item.DaDoc ? "unread" : "")"><div class="notification-icon"><icon name="@(item.LoaiThongBao == "danh_gia" ? "star" : "bell")" /></div><div class="notification-main"><h3>@item.TieuDe @if (!item.DaDoc) { <span class="badge badge-gold">Mới</span> }</h3><p>@item.NoiDung</p><small>@Ui.DateTimeText(item.NgayTao)</small>@if (!string.IsNullOrEmpty(item.MaBDS)) { <a class="notification-link" asp-controller="Home" asp-action="Details" asp-route-id="@item.MaBDS">Xem tin liên quan →</a> }</div><div class="notification-actions">@if (!item.DaDoc) { <form asp-action="ReadNotification" method="post"><input type="hidden" name="maThongBao" value="@item.MaThongBao" /><button type="submit" class="icon-button" aria-label="Đánh dấu đã đọc"><icon name="check" /></button></form> }<form asp-action="DeleteNotification" method="post" data-confirm="Xóa thông báo này?"><input type="hidden" name="maThongBao" value="@item.MaThongBao" /><button type="submit" class="icon-button" aria-label="Xóa thông báo"><icon name="trash" /></button></form></div></article> }</div> }
