@model ProfileVM
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Hồ sơ cá nhân"; }
<div class="page-heading"><div><div class="eyebrow">THÔNG TIN CÁ NHÂN</div><h1>Hồ sơ của bạn</h1><p>Thông tin đầy đủ giúp việc kết nối trở nên dễ dàng hơn.</p></div><span class="badge badge-gold">@Ui.Role(Model.VaiTro)</span></div>
<form asp-action="Profile" method="post" class="panel"><div asp-validation-summary="ModelOnly"></div><div class="panel-heading"><h2>Thông tin cơ bản</h2></div><div class="form-grid">
    <div class="form-field full"><label asp-for="HoTen">Họ và tên</label><input asp-for="HoTen" autocomplete="name" required /><span asp-validation-for="HoTen"></span></div>
    <div class="form-field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="email" required /><span asp-validation-for="Email"></span></div><div class="form-field"><label asp-for="SDT">Số điện thoại</label><input asp-for="SDT" type="tel" autocomplete="tel" required /><span asp-validation-for="SDT"></span></div>
    <div class="form-field"><label asp-for="GioiTinh">Giới tính</label><select asp-for="GioiTinh"><option value="">Chưa cập nhật</option><option value="nam">Nam</option><option value="nu">Nữ</option><option value="khac">Khác</option></select><span asp-validation-for="GioiTinh"></span></div>
    <div class="form-field"><label>Loại tài khoản</label><input value="@Ui.Role(Model.VaiTro)" readonly aria-label="Loại tài khoản" /><span class="hint">Liên hệ quản trị viên nếu cần thay đổi vai trò.</span></div>
</div>
@if (Model.VaiTro == UserRoles.Broker) { <hr class="form-separator" /><div class="panel-heading"><div><h2>Hồ sơ môi giới</h2><p>Thông tin này xuất hiện trên trang môi giới công khai.</p></div></div><div class="form-grid"><div class="form-field full"><label asp-for="GioiThieu">Giới thiệu</label><textarea asp-for="GioiThieu" maxlength="1200" placeholder="Giới thiệu chuyên môn và cách bạn hỗ trợ khách hàng..."></textarea><span asp-validation-for="GioiThieu"></span></div><div class="form-field"><label asp-for="KinhNghiem">Số năm kinh nghiệm</label><input asp-for="KinhNghiem" type="number" min="0" max="60" /><span asp-validation-for="KinhNghiem"></span></div><div class="form-field"><label asp-for="TrangThaiMoiGioi">Trạng thái hoạt động</label><select asp-for="TrangThaiMoiGioi"><option value="dang_hoat_dong">Đang hoạt động</option><option value="ngung_hoat_dong">Tạm ngừng hoạt động</option></select></div><div class="form-field full"><label asp-for="KhuVucHoatDong">Khu vực hoạt động</label><input asp-for="KhuVucHoatDong" placeholder="TP. Hồ Chí Minh, Bình Dương" /><span class="hint">Phân cách các khu vực bằng dấu phẩy.</span><span asp-validation-for="KhuVucHoatDong"></span></div></div> }
<div class="form-actions"><button class="btn btn-primary" type="submit"><icon name="check" />Lưu thay đổi</button><a class="btn btn-outline" asp-action="Index">Quay lại</a></div></form>
