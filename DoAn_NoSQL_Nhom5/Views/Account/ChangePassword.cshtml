@model PasswordVM
@{ Layout = "_AccountLayout"; ViewData["Title"] = "Bảo mật tài khoản"; }
<div class="page-heading"><div><div class="eyebrow">BẢO MẬT TÀI KHOẢN</div><h1>Đổi mật khẩu</h1><p>Chọn một mật khẩu riêng cho tài khoản HomeLand của bạn.</p></div></div>
<section class="panel"><div class="panel-heading"><h2>Cập nhật mật khẩu</h2><span class="badge badge-gold"><icon name="shield" />Bảo mật</span></div><form asp-action="ChangePassword" method="post" style="max-width:460px"><div asp-validation-summary="ModelOnly"></div>
@foreach (var field in new[] { "CurrentPassword", "NewPassword", "ConfirmPassword" }) { <div class="form-field"><label for="@field">@(field == "CurrentPassword" ? "Mật khẩu hiện tại" : field == "NewPassword" ? "Mật khẩu mới" : "Nhập lại mật khẩu mới")</label><div class="password-wrap"><input type="password" id="@field" name="@field" autocomplete="@(field == "CurrentPassword" ? "current-password" : "new-password")" required maxlength="128" minlength="@(field == "CurrentPassword" ? 1 : 8)" /><button class="password-toggle" type="button" data-password-toggle="@field" aria-label="Hiện mật khẩu"><icon name="eye" /></button></div>@Html.ValidationMessage(field)</div> }
<p class="muted" style="font-size:12px">Mật khẩu mới có ít nhất 8 ký tự. Sau khi đổi, bạn cần đăng nhập lại trên các thiết bị đang sử dụng.</p><button class="btn btn-primary" type="submit"><icon name="lock" />Cập nhật mật khẩu</button></form></section>
